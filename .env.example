# Server runtime configuration

# Required: Nextcloud base URL used by the backend proxy and login flow.
NC_URL=https://cloud.example.com

# Required for sessions to survive server restart. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: backend port. Defaults to 3000.
PORT=3000

# Optional: encrypted session store path. Defaults to .data/sessions.json.
SESSION_FILE=.data/sessions.json

# Optional: agent API for AI clients. Disabled unless set to true. See docs/AGENT_API.md.
AGENT_API_ENABLED=false

# Optional: agent token store path. Defaults to .data/agent-tokens.json.
AGENT_TOKEN_FILE=.data/agent-tokens.json

# Optional: agent requests per token per minute. Defaults to 120.
AGENT_API_RATE_MAX=120

# E2E note: VITE_NC_URL, VITE_NC_USER, and VITE_NC_PASS in .env.local are now
# only used by the Playwright scaffolding. They are not shipped to the browser.
